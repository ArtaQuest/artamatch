node_modules/
dist/
*.local
.DS_Store
.vite/
tsconfig.tsbuildinfo

# Scratch files that review agents write into the repo while probing. Three have been swept into
# commits by `git add -A` — one of them broke CI with a hardcoded absolute path.
_*.mjs
_*.ts
*.tmp.mjs
*.tmp.ts
tests/_*
tools/_*

# The research datasets and their raw query caches — tens of MB, and regenerable in a couple of minutes
# by `node research/collect.mjs` / `collect-divorce.mjs`. The scripts and the findings are the
# artefacts; the JSON is not, and every count in research/README.md is reproducible from the scripts.
research/data/
research/data-divorce/

# Kaggle credentials must never enter the repo — an agent copied one into research/data-ext once
kaggle.json
.kagglecfg/

# Regenerable compute caches — block matrices and ephemeris, tens of GB, never committed
astro/astro-blocks/
astro/blocks/
astro/chunks/
astro/ephem-*.npz
astro/*.joblib

# Generated browser artefacts. The SOURCE lives in web/ (index.html, *.py); the built ephemeris and the
# exported model are large binaries regenerated by astro/build_asset_v4.py and astro/fit_grid.py, and the
# copies that actually ship are the ones in docs/. Tracking both would double the repository for nothing.
web/ephem4.bin
web/model.npz
web/*.bin.tmp
web/_selftest.*
web/__pycache__/
astro/__pycache__/
astro/astro-out/rows.json
astro/astro-out/*.npy

# Regenerable Kaggle/eval payloads. `git add astro kaggle` would have committed couples-parents.json TWICE
# — 96 MB in astro/kaggle-payload/ and the same 96 MB again in kaggle/payload/ — plus a 21 MB partner search
# and a 13 MB out-of-fold matrix. All of it is rebuilt by kaggle/build_payload.py and astro/fit_*.py from the
# scraper, so the scripts are the artefact and these files are not.
astro/kaggle-payload/
kaggle/payload/
astro/partner-search.json
astro/max-out/
astro/*-out/*.npz
*.se1

# Compiled bytecode. Four .pyc files reached a commit here because the ignore list named
# web/__pycache__/ and astro/__pycache__/ individually rather than the pattern.
__pycache__/
*.pyc
